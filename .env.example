# Copy this file to .env and fill in local values. Never commit .env.
# All values below are placeholders.

# Local SQL Server connection
SQL_SERVER=localhost
SQL_DATABASE=RemittanceDb
ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Leave both empty to use Windows authentication
SQL_USERNAME=
SQL_PASSWORD=

# Claude API key for the AI SQL review (create one at platform.claude.com)
ANTHROPIC_API_KEY=

# Read-only SQL login for the Q&A agent (created by qa_agent/setup_readonly_login.py)
QA_READER_USERNAME=qa_reader
QA_READER_PASSWORD=
