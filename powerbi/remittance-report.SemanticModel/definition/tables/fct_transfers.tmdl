table fct_transfers
	lineageTag: e86591d8-0a6b-4f9c-ba2b-e022a41bc971

	measure 'Transfer Count' = COUNTROWS(fct_transfers)
		formatString: #,0
		lineageTag: 467dab78-7727-4f11-bfc1-5353f16ce438

	measure 'Completed Count' = CALCULATE(COUNTROWS(fct_transfers), fct_transfers[status] = "Completed")
		formatString: #,0
		lineageTag: e29d2a8b-f980-458f-b373-fa1af8317b4e

	measure 'Failure Rate' = DIVIDE(CALCULATE(COUNTROWS(fct_transfers), fct_transfers[status] = "Failed"), [Transfer Count])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f1eb6f04-0b95-45b4-ab4d-1647b4faa287

	measure 'Avg Minutes to Complete' = AVERAGE(fct_transfers[minutes_to_complete])
		formatString: 0
		lineageTag: 9e2035f9-eac0-4397-be4e-542747c09558

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Completed Send Amount' = CALCULATE(SUM(fct_transfers[send_amount]), fct_transfers[status] = "Completed")
		formatString: #,0
		lineageTag: 5b6daaac-84d7-4a61-a59f-ed2e5e62df30

	measure 'Failed Count' = CALCULATE(COUNTROWS(fct_transfers), fct_transfers[status] = "Failed")
		formatString: #,0
		lineageTag: 5aa5ad76-3639-441c-aa73-ec814a57db33

